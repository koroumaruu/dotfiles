"modules": [
	"break",
	{
	"type": "OS",
	"key": "OS > ",
	"keyColor": ""
	},
	{
	"type": "Kernel",
	"key": " |- Kernel >",
	"keyColor": ""
	},
	{
	"key": " |- Age >", 
	"type": "command", 
	"text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days old",
	"keyColor": ""
	},
	 // {
	 // "type": "Packages",
	 // "key": " |- Pkgs >",
	 // "format": "{6} (xbps)",
	 // "keyColor": ""
	 // },
	"break",
	{
	"type": "Host",
	"key": "Laptop >",
	"format": "{1}",
	"keyColor": ""
	},
	{
	"type": "Cpu",
	"key": " |- CPU >",
	"keyColor": ""
	},
	//{
	//"type": "gpu",
	//"key": " |- GPU >",
	//"keyColor": ""
	//},
	{
	"type": "memory",
	"key": " |- Memory >",
	"keyColor": ""
	},
	{
	"type": "wm",
	"key": " |- WM >",
	"keyColor": ""
	},
	{
	"type": "disk",
	"key": " |- Disk >",
	"keyColor": ""
	},
	{
	"type": "localip",
	"key": " |- IpAddr >", 
	"keyColor": ""
	},
	
        "break",
        "colors",
	"break"
    ]
